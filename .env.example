# Supabase Configuration
# You can find these in your Supabase project settings -> API
VITE_SUPABASE_URL=your_supabase_project_url_here
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Gemini AI Configuration
# IMPORTANT SECURITY NOTE: In a production environment, you should move this key
# to a secure backend server. For local development with Vite, we use the VITE_ prefix
# to make it available to the local dev server.
VITE_GEMINI_API_KEY=your_gemini_api_key_here
VITE_GEMINI_MODEL=gemini-2.5-flash-lite
